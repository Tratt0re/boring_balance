{
  "name": "boringbalance",
  "version": "1.0.2",
  "description": "Simple personal finance, without the noise",
  "author": "Tratt0re",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tratt0re/boring_balance.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:web": "node scripts/build-web.js",
    "build:preload": "node scripts/build-preload.js",
    "build:preload:prod": "node scripts/build-preload.js --prod",
    "build:prod": "npm run build:web && npm run build:preload:prod",
    "preload:watch": "node scripts/build-preload.js --watch",
    "build:desktop": "npm run build:prod && electron-builder --dir --publish never",
    "dist": "npm run build:prod && electron-builder --publish never",
    "dist:mac": "npm run build:prod && electron-builder --mac --publish never",
    "dist:win": "npm run build:prod && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build:prod && electron-builder --linux --publish never",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:electron": "node scripts/test-electron.js",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"electron/**/*.js\" \"tests/**/*.js\" \"scripts/*.js\" \"public/i18n/*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"electron/**/*.js\" \"tests/**/*.js\" \"scripts/*.js\" \"public/i18n/*.json\" \".github/**/*.yml\"",
    "dev:bridge": "node scripts/dev-ipc-bridge.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "npm run build:preload && electronmon .",
    "electron:start": "npm run build:preload && electron .",
    "electron:prod": "npm run build:prod && electron . --prod",
    "dev": "concurrently -k \"ng serve\" \"npm run preload:watch\" \"wait-on http://localhost:4200 && npm run electron:dev\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "build": {
    "appId": "com.boringbalance.desktop",
    "productName": "Boring Balance",
    "icon": "src/assetts/icon/bb_ico_1024.png",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/boringbalance/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance"
    },
    "win": {
      "icon": "src/assetts/icon/bb_ico_1024.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "boring-balance-setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "boring-balance-portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    },
    "afterPack": "./scripts/electron-fuses.js"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "exceljs": "^4.4.0",
    "lucide-angular": "^0.563.0",
    "ngx-echarts": "^21.0.0",
    "ngx-sonner": "^3.1.0",
    "rxjs": "~7.8.0",
    "semver": "^7.7.4",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4.1.18",
    "concurrently": "^9.2.1",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "electronmon": "^2.0.4",
    "esbuild": "0.27.2",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  }
}
